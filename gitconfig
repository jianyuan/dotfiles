[core]
	excludesfile = ~/.gitignore_global
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[init]
	defaultBranch = main
[alias]
	append = town append
	compress = town compress
	contribute = town contribute
	diff-parent = town diff-parent
	down = town down
	hack = town hack
	delete = town delete
	observe = town observe
	park = town park
	prepend = town prepend
	propose = town propose
	rename = town rename
	repo = town repo
	set-parent = town set-parent
	ship = town ship
	sync = town sync
	up = town up
	cleanup = !git fetch -p && git for-each-ref refs/heads --format=\"%(refname:short) %(upstream:track)\" | awk \"\\$2 == \\\"[gone]\\\" {print \\$1}\" | xargs -r git branch -D
[git-town]
	sync-feature-strategy = rebase
